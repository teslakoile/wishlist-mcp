# The wishlist REST API this server reads and writes through.
WISHLIST_MCP_API_BASE_URL=https://api.wishlist.fit

# WorkOS AuthKit is the authorization server. This server never issues tokens;
# it verifies them. Leave the domain empty and the server refuses to start.
WISHLIST_MCP_AUTHKIT_DOMAIN=https://potent-lavender-04.authkit.app

# The canonical resource URI. Every access token must carry exactly this as its
# audience, per RFC 8707, and the protected resource metadata must echo it
# character for character. A mismatch is why a client refuses to connect.
WISHLIST_MCP_RESOURCE_URI=https://mcp.wishlist.fit/mcp

# The server 404s on any other host, so nobody reaches it by a name whose
# audience will not match.
WISHLIST_MCP_HOST=mcp.wishlist.fit

# Seconds to wait on the wishlist API.
WISHLIST_MCP_API_TIMEOUT=15
